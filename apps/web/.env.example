# Copy to .env.local (never commit it). Both values are safe in the browser.
# Leave empty for local single-rider mode with no login.
# Firebase → Project settings → Your apps → Web app config. The API key only identifies the project to Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <project id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Only when the API is on a different origin than the site (e.g. https://myfitbike-api.<you>.workers.dev)
VITE_API_BASE=
