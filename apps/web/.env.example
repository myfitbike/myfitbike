# Copy to .env.local (never commit it). Both values are safe in the browser.
# Leave empty for local single-rider mode with no login.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only when the API is on a different origin than the site (e.g. https://myfitbike-api.<you>.workers.dev)
VITE_API_BASE=
