# Copy to .env (never commit .env)
PORT=8787
DATABASE_URL=postgres://localhost:5432/myfitbike
TEST_DATABASE_URL=postgres://localhost:5432/myfitbike_test
# Strava (Phase 2, opt-in): from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 32-byte hex key that encrypts stored Strava tokens: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
