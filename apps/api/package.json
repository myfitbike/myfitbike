{
  "name": "@myfitbike/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev --port 8788",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@myfitbike/shared": "workspace:*",
    "@myfitbike/world": "workspace:*",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  }
}
