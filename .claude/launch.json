{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spikes",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "spikes/serve.py",
        "5180",
        "spikes"
      ],
      "port": 5180
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@veloworld/api",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@veloworld/web",
        "dev"
      ],
      "port": 5173
    }
  ]
}